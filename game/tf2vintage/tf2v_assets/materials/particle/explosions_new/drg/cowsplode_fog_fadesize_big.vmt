SpriteCard
{
	$basetexture		"effects/outline_translucent"
	$vertexcolor		1
	$vertexalpha		1
	$translucent		1

	$blendframes		1
	$depthblend		1
	$depthblendscale		100
	$overbrightfactor		10

	// These below used so the smoke fades to transparency as it gets closer/larger on your screen, helping a bit with visibility.
	$startfadesize		0.3	// Start fading out when sprite takes up this much space on the screen.
	$endfadesize		0.6	// Fully fade out when sprite takes up this much space on the screen.
}