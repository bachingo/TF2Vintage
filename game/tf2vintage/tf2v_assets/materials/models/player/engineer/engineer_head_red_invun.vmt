Patch
{
	include	"materials/models/player/shared/invuln/invuln_red_head.vmt"
	insert
	{
		$basetexture		"models/player/engineer/engineer_head"
		$bumpmap		"models/player/engineer/hwm/engineer_head_phongmask"
		
		// Emissive Blend
		// This is used to provide illumination for the eyes, independent from the $selfillum used by the rest of the head/body.
		// So glad this exists, b/c otherwise I think making the eyes glow a separate color from the rest of the body would be impossible!
		$emissiveblendenabled	1
		$emissiveblendstrength	1.0				// Must be float, or Clamp proxy won't save the value properly!
		$emissiveBlendTexture	"dev/null"			// Dummy texture
		$emissiveBlendBaseTexture	"models/player/engineer/engineer_head_invun_emissiveblend"
		$emissiveBlendFlowTexture	"dev/null"			// Dummy texture
		$emissiveBlendTint		"[1.0 1.0 0.0]"
		$emissiveBlendScrollVector	"[0 0]"				// We're not actually scrolling anything, so [0 0]!
	}
}