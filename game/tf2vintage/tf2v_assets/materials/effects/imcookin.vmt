"UnlitTwoTexture"
{
//	"$basetexture" "effects/tiledfire/fireLayeredSlowTiled512.vtf"
	"$basetexture" "effects/tiledfire/fireLayeredSlowTiled512_purple.vtf"

	"$texture2" "effects/imcookin_2"
//	"$texture2" "effects/tiledfire/fireLayeredSlowTiled512.vtf"
	"$additive" "1"
	"$burnlevel" "0"
	"$color" "[1 1 1]"

	"Proxies"
	{

		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 60		// Original animation rate was 40; increased to 60 for smoother look
		}
//		"AnimatedTexture"					// Unnecessary; imcookin_2.vtf isn't even an animated texture
//		{
//			"animatedtexturevar" "$texture2"
//			"animatedtextureframenumvar" "$frame2"
//			"animatedtextureframerate" 40
//		}
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" ".5"
			"texturescrollangle" "90"
		}
		"BurnLevel"
		{
			"resultVar" "$burnlevel"
		}

		"Equals"
		{
			"srcVar1" "$burnlevel"
			"resultVar" "$color[0]"
		}
		"Equals"
		{
			"srcVar1" "$burnlevel"
			"resultVar" "$color[1]"
		}
		"Equals"
		{
			"srcVar1" "$burnlevel"
			"resultVar" "$color[2]"
		}
		


	}

}
