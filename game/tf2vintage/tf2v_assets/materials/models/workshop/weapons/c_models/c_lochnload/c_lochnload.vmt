"VertexLitGeneric"
{
	"$baseTexture" "models/workshop/weapons/c_models/c_lochnload/c_lochnload"
	"$basemapalphaphongmask" 1

	"$phong" "1"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "10"
	"$phongalbedotint" "1"
	"$phongboost" "66"	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"

	"$detail" "models/workshop/weapons/c_models/c_lochnload/p_lochnload_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.7"
	"$detailblendmode" "0"

	"$tempvar" "0"

	"$basephongexponent" "15"
	"$basephongboost" "3"

	"$commadd_phongexponent" "30"
	"$commadd_phongboost" 	"22.5"
	"$commweapon"		"0"

	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "1.5"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
        "WeaponSkin"
        {
        }
	}
}