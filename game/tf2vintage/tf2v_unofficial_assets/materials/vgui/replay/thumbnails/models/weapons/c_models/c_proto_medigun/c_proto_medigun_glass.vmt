"VertexLitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/models/weapons/c_models/c_proto_medigun/c_proto_medigun_glass"
	"$bumpmap" "vgui/replay/thumbnails/models/weapons/c_models/c_proto_medigun/c_proto_medigun_glass_normal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.3 .3 .3]"
	"$envmapfresnel" 1
	"$envMapFresnelMinMaxExp" "[2 1 4]"
	"$baseAlphaEnvMapMaskMinMaxExp" "[0 1 1]"
	"$translucent"	1
	"$halflambert" "1"

	//phong properties
	"$phong"	"1"
	"$phongboost"	"3"
	"$phongexponent"	"65"
	"$phongfresnelranges"	"[.5 1 4]"
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"

	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" "2"

	"$glowcolor" "1"
	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}