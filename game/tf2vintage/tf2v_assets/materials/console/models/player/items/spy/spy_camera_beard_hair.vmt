"VertexLitGeneric"
{
	"$baseTexture" "models/player/items/spy/spy_camera_beard_hair.vtf"
	"$bumpmap" "models/effects/flat_normal"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512"	
	"$detailscale" "5"
	"$detailblendfactor" ".01"
	"$detailblendmode" "6"

	"$yellow" "0"

	"$translucent" "1" 
//	"$alphatest" "1"
	"$nocull" "1"

	"$phong" "1"
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$halflambert" "1"

	"$rimlight" "1"	
	"$rimlightexponent" "8"
	"$rimlightboost" "0.65"

 	"$blendtintbybasealpha" "0" 
 	"$blendtintcoloroverbase" "0"  

	"$colortint_base" "{40 36 24}"
	"$colortint_tmp" "[0 0 0]" 

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"ItemTintColor"
		{
			"resultVar" "$colortint_tmp"
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}