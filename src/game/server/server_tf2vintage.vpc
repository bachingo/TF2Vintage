//-----------------------------------------------------------------------------
//	SERVER_TF2VINTAGE.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"tf2vintage"

$Include "$SRCDIR\game\server\server_tf.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\tf,.\tf,.\tf\bot"
		$PreprocessorDefinitions		"$BASE;TF_VINTAGE"
	}
}

$Project "Server (TF)"
{
	$Folder	"Source Files"
	{	
		$File   "$SRCDIR\game\shared\basescriptedweapon.cpp"
		$File   "$SRCDIR\game\shared\basescriptedweapon.h"
		$File   "ScriptGameEventListener.cpp"
		$File   "ScriptGameEventListener.h"
		$File   "netpropmanager.cpp"
