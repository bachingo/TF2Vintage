//-----------------------------------------------------------------------------
//	TF2VINTAGE_CRASH.VPC
//
//	Minimal crash handler DLL/SO for TF2 Vintage.
//	Registers before client.dll/server.so so crashes during DLL init and
//	global constructors are captured before the engine loads.
//
//	Windows: unhandled exception filter via AddVectoredExceptionHandler
//	Linux:   POSIX signal handlers via sigaction + self-pipe + worker thread
//
//	Deliberately has NO dependencies on tier0, tier1, mathlib, or any other
//	Source library — if those fail to load we still need to catch the crash.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\\.."
$Macro GAMENAME		"tf2vintage"
$Macro OUTBINDIR	"$SRCDIR\\..\\game\\$GAMENAME\\bin\\x64"
$Macro CRASHSRC		"$SRCDIR\\game\\crash_handler"

$Include "$SRCDIR\\vpc_scripts\\source_dll_base.vpc"

//
// Named $Configuration blocks may ONLY contain $General (output/intermediate dirs).
// $Compiler and $Linker settings belong in the nameless $Configuration {} block below.
// Use [$RELEASE] / [$DEBUG] conditionals there for per-config differences.
//

$Configuration "Release"
{
	$General
	{
		$OutputDirectory		"$OUTBINDIR"
		$IntermediateDirectory	".\Release_x64\tf2vintage_crash"
	}
}

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory		"$OUTBINDIR"
		$IntermediateDirectory	".\Debug_x64\tf2vintage_crash"
	}
}

// Nameless block — applies to all configurations.
// Per-config differences use [$RELEASE] / [$DEBUG] conditionals.
$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	""

		// Windows defines
		$PreprocessorDefinitions		"$BASE;TF_VINTAGE"					[$WINDOWS]
		$PreprocessorDefinitions		"$BASE;NDEBUG"						[$WINDOWS&&$RELEASE]
		$PreprocessorDefinitions		"$BASE;_DEBUG"						[$WINDOWS&&$DEBUG]

		// Linux defines
		$PreprocessorDefinitions		"$BASE;TF_VINTAGE;POSIX;LINUX"		[$POSIX]
		$PreprocessorDefinitions		"$BASE;NDEBUG"						[$POSIX&&$RELEASE]
		$PreprocessorDefinitions		"$BASE;_DEBUG"						[$POSIX&&$DEBUG]

		$Optimization					"Maximize Speed (/O2)"				[$WINDOWS&&$RELEASE]
		$Optimization					"Disabled (/Od)"					[$WINDOWS&&$DEBUG]
		$Optimization					"3"									[$POSIX&&$RELEASE]
		$Optimization					"0"									[$POSIX&&$DEBUG]

		// Disable buffer security check — this IS the crash handler.
		// /GS adds a call to __security_check_cookie which can itself fault;
		// we don't want the CRT touching anything before our handler fires.
		$BufferSecurityCheck			"No (/GS-)"							[$WINDOWS]
	}

	$Linker [$WINDOWS]
	{
		$AdditionalDependencies			"$BASE;dbghelp.lib;psapi.lib"
		$SubSystem						"Windows (/SUBSYSTEM:WINDOWS)"
		$GenerateDebugInformation		"Yes (/DEBUG)"
		$ProgramDatabaseFile			"$OUTBINDIR\tf2vintage_crash.pdb"	[$RELEASE]
		$ProgramDatabaseFile			"$OUTBINDIR\tf2vintage_crash_d.pdb"	[$DEBUG]
		$AdditionalLibraryDirectories	""
	}

	$Linker [$POSIX]
	{
		// -ldl for dlopen/dladdr, -lpthread for worker thread,
		// -rdynamic keeps the symbol table visible to dladdr()
		$AdditionalDependencies			"$BASE;-ldl;-lpthread;-rdynamic"
		$GenerateDebugInformation		"Yes"
	}
}

$Project "tf2vintage_crash"
{
	$Folder "Source Files"
	{
		$File "$CRASHSRC\crash_handler.cpp"			[$WINDOWS]
		$File "$CRASHSRC\crash_handler_linux.cpp"	[$POSIX]
	}
}
