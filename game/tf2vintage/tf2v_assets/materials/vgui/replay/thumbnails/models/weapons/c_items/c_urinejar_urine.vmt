"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\c_items/c_urinejar_urine"
//	"$translucent" 1
	$additive 1
	"$envmap" "env_cubemap"
	"$envmaptint" "[.75 .75 0]"
	"$halflambert" 1

	$nocull 1
	"$phong" "1"
	"$phongexponent" 50
	"$phongfresnelranges" "[1 2 3]"
	"$lightwarptexture" "models\lightwarps\jarate_lightwarp"
	"$phongboost" "1"
	"$basemapalphaphongmask" "1"

	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" ".25"

	"$glowcolor" "1"
	"$yellow" "0"

    "Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}

