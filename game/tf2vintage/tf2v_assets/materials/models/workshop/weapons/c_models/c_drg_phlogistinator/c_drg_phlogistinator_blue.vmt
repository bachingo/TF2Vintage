"VertexLitGeneric"
{
	"$basetexture"	"models/weapons/c_items/c_drg_phlogistinator_blue"
	
	"$phong" "1"
	"$phongboost" "50"	
	"$phongexponentfactor"  "30"
	"$basemapalphaphongmask" "1"
	"$phongalbedotint" "1"
	"$phongexponenttexture"	"models/weapons/albedo_tint"
	"$phongfresnelranges"	"[.3 .5 3]"
	"$glowcolor" "1"

	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"	

	"$tempvar" "0"
	
	"$rimlight" "1"						
	"$rimlightexponent" "7"				
	"$rimlightboost" "0.5"
	

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	
	
		"WeaponSkin" {
		}
	}
}