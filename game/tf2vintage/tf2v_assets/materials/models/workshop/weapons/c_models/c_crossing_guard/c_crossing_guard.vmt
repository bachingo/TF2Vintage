"VertexLitGeneric"
{
	"$baseTexture" "models/workshop/weapons/c_models/c_crossing_guard/c_crossing_guard"
	"$bumpmap" "models/player/shared/shared_normal"

	"$phong" "1"
	"$phongboost"	"25"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "20"
	"$phongalbedotint" "1"
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongfresnelranges"	"[.3 .5 3]"
	"$basemapalphaphongmask" "1"
	"$halflambert" "0"
	
	"$rimlight" "1"					
	"$rimlightexponent" "2"		
	"$rimlightboost" "1"
	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"

	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}