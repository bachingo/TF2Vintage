# Custom Build Tool "vscript_init.nut produces vscript_init_nut.h" for file "vscript/languages/squirrel/vscript_init.nut"
rule vscript_buildtool_vscript_dir_languages_dir_squirrel_dir_vscript_init_dot_nut
  command = oldpath="$$(pwd)" cd "vscript" > /dev/null && perl ../devtools/bin/texttoarray.pl languages/squirrel/vscript_init.nut g_Script_init> languages/squirrel/vscript_init_nut.h && cd "$$oldpath" > /dev/null
