"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\w_stickybomb_launcher/w_stickybomb_launcher_defender"
	"$yellow" "0"
	"$basemapalphaphongmask" "1"

	"$phong" "1"
	"$phongboost" "2"	
	"$phongexponentfactor"  "8"
	"$basemapalphaphongmask" "1"
	"$phongalbedotint" "1"
	"$phongexponenttexture"	"models/weapons/albedo_tint"

	"$phongfresnelranges"	"[1.5 .5 3]"

	"$detail" 	"models/weapons/c_models/c_stickybomb_launcher/p_stickybomb_launcher_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "1"
	"$detailblendmode" "0"

	"$cloakPassEnabled" "1"

	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$glowcolor" "1"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}