#include <windows.h>

// Application icon
1 ICON "tf2vintage.ico"

// Application manifest — required by lxn/walk for Common Controls v6.
// Without this, TTM_ADDTOOL fails and the GUI crashes on startup.
1 RT_MANIFEST "tf2vintage.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TF2 Vintage Team"
            VALUE "FileDescription",  "TF2 Vintage Updater / Installer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "tf2vintage-updater"
            VALUE "LegalCopyright",   "Copyright (C) 2017-2026 TF2 Vintage Team"
            VALUE "OriginalFilename", "tf2vintage-updater.exe"
            VALUE "ProductName",      "Team Fortress 2: Vintage"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
