"VertexLitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/medic/robo_backpack_blue"
	"$basemapalphaphongmask" "1"

	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost" "10"
	"$lightwarptexture" "vgui/replay/thumbnails/models/lightwarps/robot_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"
	"$halflambert"	"1"

	"$glowcolor" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "2"
	
 	"$blendtintbybasealpha" "1" 
	"$blendtintcoloroverbase" "0"  

	"$colortint_base" "{242 166 66}"
	"$colortint_tmp" "[0 0 0]" 
	"$color2" "{242 166 66}"

	"$yellow" "0"
	"$one" "1"

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"ItemTintColor"
		{
			"resultVar" "$colortint_tmp"
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}