"VertexLitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/all_class/fob_heavy"
	"$bumpmap" "models/player/items/mvm_loot/all_class/fob_heavy_normal"
	"$basemapalphaphongmask" "0"
	"$halflambert" "1"

	"$nocull" "1"

	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost" "3"	
	"$lightwarptexture" "vgui/replay/thumbnails/models/lightwarps/robot_lightwarp"
	"$phongfresnelranges"	"[1 1 1]"

	"$glowcolor" "1"
	
	"$rimlight" "1"						
	"$rimlightexponent" "12"				
	"$rimlightboost" "1"								// Boost for ambient cube component of rim lighting
	
 	"$blendtintbybasealpha" "1" 
	"$blendtintcoloroverbase" "0"  

	"$colortint_base" "{242 166 66}"
	"$colortint_tmp" "[0 0 0]" 
	"$color2" "{242 166 66}"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"ItemTintColor"
		{
			"resultVar" "$colortint_tmp"
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}