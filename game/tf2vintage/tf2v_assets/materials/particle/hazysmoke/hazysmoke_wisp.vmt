// Sequence info:
//	Alpha Sequences:
//		Seq 0-1: Two static alpha masks, modified from wispy_smoke2.vtf. Sequence 1 takes up a larger tile size, is a bit brighter, and has a "bloom" effect
//	RGB Sequences:
//		Seq 2-13: Looping animated smoke pattern at different frame offsets.
SpriteCard
{
	$basetexture	"particle/hazysmoke/hazysmoke_wisp"

	$ramptexture	"particle/ramptextures/skellgray/ramp_hazysmoke_inout"	// Red values on the basetexture are remapped to the corresponding color on this ramp texture. Think of it like a palette swap or a lightwarp-like effect.

//	$additive		1	// $addself automatically forces translucency instead of additive (ironically)
//	$addself		6.66	// Very good year...
	$addself		4.0

	$vertexcolor 	1
	$vertexalpha	1

	$dualsequence		1
	$sequence_blend_mode	1	// Sequence blend mode 1: alpha from first sequence, RGB from second
	$maxlumframeblend1	0	// Blend based on pixel max luminance? (I have no idea what this even means or what it'd ever be useful for)
	$maxlumframeblend2	0
//	$zoomanimateseq2		1.15	// DISABLED

	$overbrightfactor	4.0

	$blendframes	1
	$depthblend	1
	$depthblendscale	20
}