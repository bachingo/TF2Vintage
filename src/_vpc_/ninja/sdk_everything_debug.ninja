########################
# mathlib
########################

mathlib_defines = -DVPC -DSOURCESDK -DSOURCE_HAS_FREETYPE -DDEBUG -D_DEBUG -DGNUC -DPOSIX -DCOMPILER_GCC -D_DLL_EXT=.so -D_LINUX -DLINUX -DPLATFORM_64BITS -DPOSIX -D_POSIX -DBINK_VIDEO -DGL_GLEXT_PROTOTYPES -DDX_TO_GL_ABSTRACTION -DUSE_SDL -DDEV_BUILD -DFRAME_POINTER_OMISSION_DISABLED -DMATHLIB_LIB -D_DLL_EXT=.so -D_DLL_PREFIX=lib -D_EXTERNAL_DLL_EXT=.so -D_LINUX=1 -D_LINUXSTEAMRT64=1 -D_POSIX=1 -DLINUX=1 -DLINUX64=1 -DLINUXSTEAMRT64=1 -DPOSIX=1 -DPROJECTDIR=/TF2Vintage/src/mathlib -DSYSTEM_TRIPLE=x86_64-linux-gnu -DVPCGAME=tf2vintage -DVPCGAMECAPS=TF2VINTAGE 
mathlib_forceincludes = 
mathlib_includes = -Icommon -I_vpc_/ninja/debug/pchs/mathlib/common -Ipublic -I_vpc_/ninja/debug/pchs/mathlib/public -Ipublic/tier0 -I_vpc_/ninja/debug/pchs/mathlib/public/tier0 -Ipublic/tier1 -I_vpc_/ninja/debug/pchs/mathlib/public/tier1 -I../../usr/include/SDL2 -I_vpc_/ninja/debug/pchs/mathlib/../../usr/include/SDL2 -Ipublic/mathlib -I_vpc_/ninja/debug/pchs/mathlib/public/mathlib 
mathlib_libs = 
mathlib_cflags = -fvisibility=hidden $mathlib_includes $mathlib_defines $mathlib_forceincludes  -lm -Wno-overloaded-virtual -Wno-placement-new -Wno-c++20-compat -Wno-mismatched-new-delete -Wno-class-memaccess -Wno-conversion-null -Wno-invalid-offsetof -Wno-reorder
mathlib_cxxflags = $mathlib_cflags 
mathlib_ldflags = 

build _vpc_/ninja/debug/objs/mathlib/color_conversion.o: cxx mathlib/color_conversion.cpp
  project_cxxflags = $mathlib_cxxflags
build _vpc_/ninja/debug/objs/mathlib/halton.o: cxx mathlib/halton.cpp
  project_cxxflags = $mathlib_cxxflags
build _vpc_/ninja/debug/objs/mathlib/lightdesc.o: cxx mathlib/lightdesc.cpp
  project_cxxflags = $mathlib_cxxflags
