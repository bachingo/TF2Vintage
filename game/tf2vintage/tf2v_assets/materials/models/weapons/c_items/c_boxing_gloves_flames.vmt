"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\c_items/c_boxing_gloves_flames"
	"$bumpmap" "models\weapons\c_items/c_boxing_gloves_normal"



	"$phong" "1"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "30"
	"$phongboost" "40"
	"$phongalbedotint"	"1"	
//	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongfresnelranges"	"[.25 .55 3]"
	"$halflambert" "0"
//	"$basemapalphaphongmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "3"
	"$rimlightboost" ".2"
	"$rimmask" "1"


	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}