"VertexlitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/all_class/fob_heavy_diamond_black"
	"$basemapalphaphongmask" "1"
	"$yellow" "0"
	"$halflambert" "1"

//	"$translucent" 1
//	"$nocull" 1 

	"$phong" "1"
	"$phongexponent" "50"
	"$phongboost" "5"
	"$lightwarptexture" "vgui/replay/thumbnails/models/lightwarps/robot_lightwarp"	
	"$phongfresnelranges"	"[1 1 1]"
	"$phongwarptexture" "models/player/items/all_class/all_class_ring_warp"
	"$phongtint" "[0.78 1.02 1.9]"

	"$envmap" "env_cubemap"
	"$envmaptint" "[0.08 0.2 0.4]"

	"$glowcolor" "1"
	// Rim lighting parameters
	"$rimlight" "1"											// To enable rim lighting (requires phong)
	"$rimlightexponent" "150"									// Exponent for phong component of rim lighting	
	"$rimlightboost" "2"										// Boost for ambient cube component of rim lighting

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}