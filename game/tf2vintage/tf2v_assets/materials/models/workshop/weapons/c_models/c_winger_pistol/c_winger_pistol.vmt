"VertexlitGeneric"
{
	"$baseTexture" "models/workshop/weapons/c_models/c_winger_pistol/c_winger_pistol"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[.2 .2 .2]"

	"$phong" "1"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "35"
	"$phongboost" "15"
	"$phongalbedotint" "1"	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongwarptexture"  "models/player/items/all_class\qc_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"

	"$detail" "models/workshop/weapons/c_models/c_winger_pistol/p_winger_pistol_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.5"
	"$detailblendmode" "0"


	"$basemapalphaphongmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "2"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"
		{
		}
	}
}