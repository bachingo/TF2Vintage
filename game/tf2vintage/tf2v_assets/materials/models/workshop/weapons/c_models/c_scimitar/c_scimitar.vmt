"VertexLitGeneric"
{
	"$basetexture"	"models/workshop/weapons/c_models/c_scimitar/c_scimitar"
	"$basemapalphaphongmask" "1"
	"$phong" "1"

	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "30"
	"$phongalbedotint" "1"
	"$phongboost" "100"	
	"$phongfresnelranges"	"[.25 .5 1]"
	
	"$lightwarptexture" "models/weapons/c_items/c_ambassador_lightwarp"

	"$detail" "models/workshop/weapons/c_models/c_scimitar/p_scimitar_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.5"
	"$detailblendmode" "0"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"
		{
		}
	}
}