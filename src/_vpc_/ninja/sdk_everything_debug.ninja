# Raytrace
########################

raytrace_defines = -DVPC -DSOURCESDK -DSOURCE_HAS_FREETYPE -DDEBUG -D_DEBUG -DGNUC -DPOSIX -DCOMPILER_GCC -D_DLL_EXT=.so -D_LINUX -DLINUX -DPLATFORM_64BITS -DPOSIX -D_POSIX -DBINK_VIDEO -DGL_GLEXT_PROTOTYPES -DDX_TO_GL_ABSTRACTION -DUSE_SDL -DDEV_BUILD -DFRAME_POINTER_OMISSION_DISABLED -D_DLL_EXT=.so -D_DLL_PREFIX=lib -D_EXTERNAL_DLL_EXT=.so -D_LINUX=1 -D_LINUXSTEAMRT64=1 -D_POSIX=1 -DLINUX=1 -DLINUX64=1 -DLINUXSTEAMRT64=1 -DPOSIX=1 -DPROJECTDIR=/TF2Vintage/src/raytrace -DSYSTEM_TRIPLE=x86_64-linux-gnu -DVPCGAME=tf2vintage -DVPCGAMECAPS=TF2VINTAGE 
raytrace_forceincludes = 
raytrace_includes = -Icommon -I_vpc_/ninja/debug/pchs/raytrace/common -Ipublic -I_vpc_/ninja/debug/pchs/raytrace/public -Ipublic/tier0 -I_vpc_/ninja/debug/pchs/raytrace/public/tier0 -Ipublic/tier1 -I_vpc_/ninja/debug/pchs/raytrace/public/tier1 -I../../usr/include/SDL2 -I_vpc_/ninja/debug/pchs/raytrace/../../usr/include/SDL2 -Iutils/common -I_vpc_/ninja/debug/pchs/raytrace/utils/common 
raytrace_libs = 
raytrace_cflags = -fvisibility=hidden $raytrace_includes $raytrace_defines $raytrace_forceincludes  -lm -Wno-overloaded-virtual -Wno-placement-new -Wno-c++20-compat -Wno-mismatched-new-delete -Wno-class-memaccess -Wno-conversion-null -Wno-invalid-offsetof -Wno-reorder
raytrace_cxxflags = $raytrace_cflags 
raytrace_ldflags = 

