# Server (TF)
########################

server_tf_defines = -DVPC -DSOURCESDK -DSOURCE_HAS_FREETYPE -DDEBUG -D_DEBUG -DGNUC -DPOSIX -DCOMPILER_GCC -D_DLL_EXT=.so -D_LINUX -DLINUX -DPLATFORM_64BITS -DPOSIX -D_POSIX -DDLLNAME=server -DBINK_VIDEO -DGL_GLEXT_PROTOTYPES -DDX_TO_GL_ABSTRACTION -DUSE_SDL -DDEV_BUILD -DFRAME_POINTER_OMISSION_DISABLED -DREPLAY_ENABLED -DGAME_DLL -DVECTOR -DVERSION_SAFE_STEAM_API_INTERFACES -DPROTECTED_THINGS_ENABLE -Dsprintf=use_Q_snprintf_instead_of_sprintf -Dstrncpy=use_Q_strncpy_instead -D_snprintf=use_Q_snprintf_instead -DINCLUDED_STEAM2_USERID_STRUCTS -DSWDS -DUSES_ECON_ITEMS -DUSE_NAV_MESH -DTF_DLL -DENABLE_GC_MATCHMAKING -DGLOWS_ENABLE -DUSE_DYNAMIC_ASSET_LOADING -DNEXT_BOT -DTF_VINTAGE -DDISABLE_GC_CONNECTION -DDISABLE_IN_SOURCESDK -DINVENTORY_VIA_WEBAPI -D_DLL_EXT=.so -D_DLL_PREFIX=lib -D_EXTERNAL_DLL_EXT=.so -D_LINUX=1 -D_LINUXSTEAMRT64=1 -D_POSIX=1 -DLINUX=1 -DLINUX64=1 -DLINUXSTEAMRT64=1 -DPOSIX=1 -DPROJECTDIR=/TF2Vintage/src/game/server -DSYSTEM_TRIPLE=x86_64-linux-gnu -DVPCGAME=tf2vintage -DVPCGAMECAPS=TF2VINTAGE 
server_tf_forceincludes = 
server_tf_includes = -Icommon -I_vpc_/ninja/debug/pchs/server_tf/common -Ipublic -I_vpc_/ninja/debug/pchs/server_tf/public -Ipublic/tier0 -I_vpc_/ninja/debug/pchs/server_tf/public/tier0 -Ipublic/tier1 -I_vpc_/ninja/debug/pchs/server_tf/public/tier1 -I../../usr/include/SDL2 -I_vpc_/ninja/debug/pchs/server_tf/../../usr/include/SDL2 -Igame/server/ -I_vpc_/ninja/debug/pchs/server_tf/game/server/ -Igame/shared -I_vpc_/ninja/debug/pchs/server_tf/game/shared -Iutils/common -I_vpc_/ninja/debug/pchs/server_tf/utils/common -Igame/shared/econ -I_vpc_/ninja/debug/pchs/server_tf/game/shared/econ -Igame/server/NextBot -I_vpc_/ninja/debug/pchs/server_tf/game/server/NextBot -Igame/server/generated_proto_tf2vintage -I_vpc_/ninja/debug/pchs/server_tf/game/server/generated_proto_tf2vintage -Ithirdparty/protobuf-2.6.1/src -I_vpc_/ninja/debug/pchs/server_tf/thirdparty/protobuf-2.6.1/src -Igcsdk/steamextra -I_vpc_/ninja/debug/pchs/server_tf/gcsdk/steamextra -Igame/shared/hl2 -I_vpc_/ninja/debug/pchs/server_tf/game/shared/hl2 -Igame/server/tf -I_vpc_/ninja/debug/pchs/server_tf/game/server/tf -Igame/server/tf/vgui -I_vpc_/ninja/debug/pchs/server_tf/game/server/tf/vgui -Istatemachine -I_vpc_/ninja/debug/pchs/server_tf/statemachine -Igame/shared/Multiplayer -I_vpc_/ninja/debug/pchs/server_tf/game/shared/Multiplayer -Igame/shared/tf -I_vpc_/ninja/debug/pchs/server_tf/game/shared/tf 
server_tf_libs =  -Llib/public/linux64 -ltier0 lib/public/linux64/tier1.a -Llib/public/linux64 -lvstdlib lib/common/linux64/replay_common.a thirdparty/protobuf-2.6.1/bin/linux64/libprotobuf.a lib/public/linux64/choreoobjects.a lib/public/linux64/dmxloader.a lib/public/linux64/mathlib.a lib/public/linux64/particles.a lib/public/linux64/tier2.a lib/public/linux64/tier3.a -Llib/public/linux64 -lsteam_api lib/public/linux64/gcsdk_sdk.a
server_tf_cflags = -fvisibility=hidden $server_tf_includes $server_tf_defines $server_tf_forceincludes  -lm -Wno-overloaded-virtual -Wno-placement-new -Wno-c++20-compat -Wno-mismatched-new-delete -Wno-class-memaccess -Wno-conversion-null -Wno-invalid-offsetof -Wno-reorder
server_tf_cxxflags = $server_tf_cflags 
server_tf_ldflags =  -lm


# Custom Build Tool "vscript_server.nut produces vscript_server_nut.h" for file "game/server/vscript_server.nut"
rule server_tf_buildtool_game_dir_server_dir_vscript_server_dot_nut
  command = oldpath="$$(pwd)" cd "game/server" > /dev/null && perl ../../devtools/bin/texttoarray.pl vscript_server.nut g_Script_vscript_server> vscript_server_nut.h && cd "$$oldpath" > /dev/null
  description = vscript_server.nut produces vscript_server_nut.h
  restat = 1
build game/server/vscript_server_nut.h: server_tf_buildtool_game_dir_server_dir_vscript_server_dot_nut game/server/vscript_server.nut


