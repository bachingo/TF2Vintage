// As of writing this comment, this material is only used for the smoke on the Huo-Long Heater's ring of fire effect.

SpriteCard
{
	$basetexture		"effects/smoke/smokelit"
	$vertexcolor		1
	$vertexalpha		1
	$translucent		1

	$blendframes		1
	$depthblend		1
	$depthblendscale		50
	$overbrightfactor		12

	// These below used so the smoke fades to transparency as it gets closer/larger on your screen, helping a bit with visibility.
//	$startfadesize		0.1875	// Start fading out when sprite takes up this much space on the screen.
//	$endfadesize		0.375	// Fully fade out when sprite takes up this much space on the screen.
	$startfadesize		0.25
	$endfadesize		0.5
}