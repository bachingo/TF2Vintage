vscript_defines = -DVPC -DSOURCESDK -DSOURCE_HAS_FREETYPE -DDEBUG -D_DEBUG -DGNUC -DPOSIX -DCOMPILER_GCC -D_DLL_EXT=.so -D_LINUX -DLINUX -DPLATFORM_64BITS -DPOSIX -D_POSIX -DDLLNAME=vscript -DBINK_VIDEO -DGL_GLEXT_PROTOTYPES -DDX_TO_GL_ABSTRACTION -DUSE_SDL -DDEV_BUILD -DFRAME_POINTER_OMISSION_DISABLED -DVSCRIPT_DLL_EXPORT -DCROSS_PLATFORM_VERSION=1 -D_DLL_EXT=.so -D_DLL_PREFIX=lib -D_EXTERNAL_DLL_EXT=.so -D_LINUX=1 -D_LINUXSTEAMRT64=1 -D_POSIX=1 -DLINUX=1 -DLINUX64=1 -DLINUXSTEAMRT64=1 -DPOSIX=1 -DPROJECTDIR=/TF2Vintage/src/vscript -DSYSTEM_TRIPLE=x86_64-linux-gnu -DVPCGAME=tf2vintage -DVPCGAMECAPS=TF2VINTAGE 
vscript_forceincludes = 
vscript_includes = -Icommon -I_vpc_/ninja/debug/pchs/vscript/common -Ipublic -I_vpc_/ninja/debug/pchs/vscript/public -Ipublic/tier0 -I_vpc_/ninja/debug/pchs/vscript/public/tier0 -Ipublic/tier1 -I_vpc_/ninja/debug/pchs/vscript/public/tier1 -I../../usr/include/SDL2 -I_vpc_/ninja/debug/pchs/vscript/../../usr/include/SDL2 -Ipublic/vscript -I_vpc_/ninja/debug/pchs/vscript/public/vscript -Ithirdparty/SQUIRREL3/include -I_vpc_/ninja/debug/pchs/vscript/thirdparty/SQUIRREL3/include -Ithirdparty/SQUIRREL3/squirrel -I_vpc_/ninja/debug/pchs/vscript/thirdparty/SQUIRREL3/squirrel -Ithirdparty/SQUIRREL3/sqplus -I_vpc_/ninja/debug/pchs/vscript/thirdparty/SQUIRREL3/sqplus -Ithirdparty/luajit/src -I_vpc_/ninja/debug/pchs/vscript/thirdparty/luajit/src -Ithirdparty/angelscript_2.32.0/sdk/angelscript/include -I_vpc_/ninja/debug/pchs/vscript/thirdparty/angelscript_2.32.0/sdk/angelscript/include -Ithirdparty/angelscript_2.32.0/sdk/add_on -I_vpc_/ninja/debug/pchs/vscript/thirdparty/angelscript_2.32.0/sdk/add_on 
