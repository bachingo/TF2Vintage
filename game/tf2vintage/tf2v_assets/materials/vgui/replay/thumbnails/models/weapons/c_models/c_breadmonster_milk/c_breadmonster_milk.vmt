"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\c_items/c_breadmonster_milk"
	"$basemapalphaphongmask" "1"

//	"$translucent" "1"
	"$additive" "1"
	"$nocull" "1"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.1 .1 .1]"
	"$envmapfresnel" "1"
	"$basealphaenvmapmask" "1"

	"$phong" "1"
	"$phongboost" "1"
	"$phongexponent" "50"
	"$phongfresnelranges" "[1 2 3]"
	"$lightwarptexture" "models\lightwarps\jarate_lightwarp"
//	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$halflambert" "1"

	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" ".25"

	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$glowcolor" "1"
	"$yellow" "0"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}