"VertexlitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/all_class/fob_heavy_diamond"
	"$yellow" "0"
	"$halflambert" "1"
	"$basemapalphaphongmask" "1"

//	"$nocull" "1"
//	"$translucent" "1"
//	"$additive" "1"
//	"$alphatest" "1"

	"$phong" "1"
	"$phongexponent" "40"
	"$phongboost" "10"
	"$lightwarptexture" "vgui/replay/thumbnails/models/lightwarps/robot_lightwarp"	
	"$phongfresnelranges"	"[1 1 1]"
	"$phongwarptexture" "models/player/items/all_class/all_class_ring_warp"
	"$phongtint" "[3 4 5.5]"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.72 .95 1]"

	// Rim lighting parameters
	"$rimlight" "1"											// To enable rim lighting (requires phong)
	"$rimlightexponent" "150"									// Exponent for phong component of rim lighting	
	"$rimlightboost" "2"										// Boost for ambient cube component of rim lighting

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}