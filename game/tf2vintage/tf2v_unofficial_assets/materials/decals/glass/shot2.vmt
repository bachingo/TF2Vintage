VertexLitGeneric
{
//	$normalmap	"decals/glass/shot2_model_normal"
	$basetexture	"decals/glass/shot2"
//	$vertexalpha	1	// Not needed for VertexLitGeneric
//	$vertexcolor	1	// Not needed for VertexLitGeneric

	// Detail texture applied as unlit additive overlay, giving the material some self-illumination
		// Helps decal appear brighter even in very dark areas, which is good b/c we usually expect cracks in glass to look substantially brighter than the glass itself.
	$detail		"decals/glass/shot2"
	$detailscale	1.0
	$detailblendmode	5	// Blend mode: Unlit Additive
	$detailblendfactor	0.10

	$translucent	1
	$decal		1
//	$model		1	// Not needed for VertexLitGeneric; shader is only used for models anyway.

	// Edit $decalscale through the respective NON-model decal material
}