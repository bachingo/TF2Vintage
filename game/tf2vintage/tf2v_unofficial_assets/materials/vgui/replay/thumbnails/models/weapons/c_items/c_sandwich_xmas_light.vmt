"VertexlitGeneric"
{
	"$baseTexture" "vgui\replay\thumbnails\models\weapons\c_items/c_sandwich_xmas"
	"$basemapalphaphongmask" 1
	"$lightwarptexture" "models/lightwarps/xms_lightwarp"
	
	"$selfillum" 1
	"$selfillummask" "models\player\items\all_class\white"
	
	"$phong"	"1"
	"$phongboost"	"5"
	"$phongexponent"	"55"
	"$phongfresnelranges"	"[1 2 2.5]"
	"$rimlight"	"1"
	"$rimlightexponent"	"35"

	"$envmap" "env_cubemap"
	"$baseAlphaEnvMapMask" "1" 

	"$glowcolor" "1"

	"360?$color2" "[ 0.9 0.8 0.8 ]"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}

		Sine
		{
			"resultVar"	"$selfillumtint" 
		        "sineperiod"	5
			"sinemin"       .3
			"sinemax"	1
		}

		Sine
		{
			"resultVar"	"$envmaptint" 
		        "sineperiod"	5
			"sinemin"       .2
			"sinemax"	.35
		}

	}
}