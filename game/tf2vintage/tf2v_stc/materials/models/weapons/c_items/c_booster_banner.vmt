"VertexlitGeneric"
{

	"$basetexture" "models\weapons\c_items\c_booster_banner"

	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost" "1"	
	"$basemapalphaphongmask" "1"
	"$phongfresnelranges"	"[.3 .5 3]"
	"$halflambert" "1"
	"$glowcolor" "1"

	"$nocull" "1"

	"$tempvar" "0"

	"$basephongexponent" "15"
	"$basephongboost" "3"


	

	
	"$rimlight" "1"						
	"$rimlightexponent" "5"				
	"$rimlightboost" ".25"


	
	

	// Cloaking
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"weapon_invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
	}





	

}
