"VertexlitGeneric"
{
	"$basetexture" "models/player/shared/ice_player"
	"$bumpmap" "vgui/replay/thumbnails/models/weapons/c_items/c_xms_cold_shoulder_normal"

	"$phong" "1"
	"$phongexponent" "200"
	"$phongboost" "100"
	"$phongfresnelranges"	"[.25 1 4]"
	"$phongwarptexture" "vgui/replay/thumbnails/models/player/shared/ice_player_warp"
	"$lightwarptexture" "vgui/replay/thumbnails/models/player/shared/ice_player_lightwarp"

	"$envmap" "Effects/cubemapper"
	"$envmaptint" "[.2 .2 .2]"

	// Rim lighting parameters
	"$rimlight" "1"					// To enable rim lighting (requires phong)
	"$rimlightexponent" "50"	// Exponent for phong component of rim lighting	
	"$rimlightboost" "15"		// Boost for ambient cube component of rim lighting

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
	}
}