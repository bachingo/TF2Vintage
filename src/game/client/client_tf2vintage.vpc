//-----------------------------------------------------------------------------
//	CLIENT_TF2VINTAGE.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"tf2vintage"

$Include "$SRCDIR\game\client\client_tf.vpc"
$Include "$SRCDIR\coplay\src\coplay.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;tf\vgui"
		$PreprocessorDefinitions			"$BASE;TF_VINTAGE_CLIENT"
	}
}

$Project "Client (TF)"
{
	$Folder	"Source Files"
	{
		$File   "$SRCDIR\game\shared\basescriptedweapon.cpp"
		$File   "$SRCDIR\game\shared\basescriptedweapon.h"
		$File	"$SRCDIR\game\shared\bannedwords.cpp"
		$File	"$SRCDIR\game\shared\bannedwords.h"
		$File	"$SRCDIR\game\shared\tf\script_parser.cpp"
		$File	"$SRCDIR\game\shared\tf\script_parser.h"
		
		$Folder	"Economy"
		{
			$File	"$SRCDIR\game\shared\econ\econ_networking.cpp"
			$File	"$SRCDIR\game\shared\econ\econ_networking.h"
			$File	"$SRCDIR\game\shared\econ\econ_networking_messages.cpp"
			$File	"$SRCDIR\game\shared\econ\econ_networking_messages.h"
		}

		$Folder	"TF"
		{
			$File	"tf\c_sdkversionchecker.cpp"
			$File	"tf\c_sdkversionchecker.h"
			$File	"tf\tf_presence.cpp"
			$File	"tf\tf_presence.h"
			$File	"tf\c_tf_spymask.cpp"
			$File	"tf\c_tf_spymask.h"
			
			$Folder	"Unused"
			{
				$File	"tf\tf_hud_health.cpp"
			}			
			
			$Folder	"vgui"
			{
				$Folder	"Unused"
				{
					$File	"tf\vgui\tf_overview.cpp"
					$File	"tf\vgui\tf_overview.h"	
				}
			}
			
			$Folder	"Weapon"
			{
				$File	"$SRCDIR\game\shared\tf\tf_weapon_defib.cpp"
				$File	"$SRCDIR\game\shared\tf\tf_weapon_defib.h"	
			
				$File	"$SRCDIR\game\shared\tf\tf_weapon_crowbar.cpp"
				$File	"$SRCDIR\game\shared\tf\tf_weapon_crowbar.h"
