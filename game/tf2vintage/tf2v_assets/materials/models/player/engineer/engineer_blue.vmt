"VertexLitGeneric"
{
	"$basetexture" "models/player/engineer/engineer_blue"
	"$bumpmap" "models/player/engineer/engineer_normal"
	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"
//	"$detailscale" 5	// Old value
	"$detailscale" 3
//	"$detailblendfactor" .01						// Old value
	"$detailblendfactor" 0.00						// New value, though I don't think this change is of much significance
//	"$detailblendmode" 6	//Old value
	"$detailblendmode" 5


	"$yellow" "0"
	"$one" "1"

// 	"$bbqamount" "1"	
// 	"$two" "2.35"
// 	"$one" "1"
// 	"$absburnminusone" "1"
// 	"$burnminusone" "1"
// 	"$finalburnlevel" "1"
// 	"$burnlevel" "0"


	"$phong" "1"

	// Below: disabled constant phong exponent & old phong boost. Replaced with exponent texture, plus new phong boost based on SFM version of this material
//	"$phongexponent" "20"
//	"$phongboost" ".3"	
	"$phongexponenttexture" "models\player\engineer\engineer_exponent"
	"$phongboost" "1"

	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
//	"$phongfresnelranges"	"[.3 1 8]"
	"$phongfresnelranges"	"[.8 1 8]"	// SFM value
	"$halflambert" "0"

	// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "4"										// Exponent for phong component of rim lighting	
	"$rimlightboost" "2"										// Boost for ambient cube component of rim lighting
	// Cloaking
	"$cloakPassEnabled" "1"

	"360?$color2" "[ 0.8 0.8 0.8 ]"

	"Proxies"
	{
		"spy_invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"TextureScroll"							// Newly added proxy; makes the fire texture continually scroll
		{
			"texturescrollvar" "$detailtexturetransform"
			"texturescrollrate" "0.15"
			"texturescrollangle" "90"
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}