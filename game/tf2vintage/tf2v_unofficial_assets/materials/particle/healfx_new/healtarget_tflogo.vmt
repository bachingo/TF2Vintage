UnlitGeneric
{
	$basetexture	"particle/tflogo/tflogo_flat"
	$detail		"effects/gradient_hourglasscycle/gradient_hourglasscycle_512"
	$additive	1
	$vertexcolor 	1
	$vertexalpha	1

	$detailscale	1.0
	$detailblendmode	8
	$detailblendfactor	1.0
	$detailtexturetransform	"center .5 .5 scale 1 1 rotate 0 translate 0 0"

	// Proxy variables
	$beat		1.0	// Declared value is dummy
	$beat_rescale	0.75
	$beat_offset	1.75	// NOTE: To ensure the texture isn't scaled beyond its own dimensions, beat_offset - beat_rescale should be >= 1

	
	$basetex_angle	0.0
	$hourglass_angle	0.0
	
	Proxies
	{
	//====================================================================================================
	// Purpose: Pulse scale for $basetexture
	//====================================================================================================
		Sine
		{
			sinePeriod	0.5
			sineMin		0.666667
			sineMax		1.0
			timeoffset		0
			resultVar		"$beat"
		}

		Multiply
		{
			srcVar1		"$beat"
			srcVar2		"$beat"
			resultVar		"$beat"
		}

		Multiply
		{
			srcVar1		"$beat"
			srcVar2		"$beat_rescale"
			resultVar		"$beat"
		}

		Subtract
		{
			srcVar2		"$beat_offset"
			srcVar1		"$beat"
			resultVar		"$beat"
		}

	//====================================================================================================
	// Purpose: Set continuous rotation for $basetexture and $detailtexture
	//====================================================================================================
		LinearRamp
		{
			rate		"90.0"
			initialValue	"0.0"
			resultVar		"$basetex_angle"
		}

		LinearRamp
		{
			rate		"-90.0"
			initialValue	"0.0"
			resultVar		"$hourglass_angle"
		}


	// Apply transformations
		TextureTransform
		{
			scaleVar		"$beat"
			rotateVar		"$basetex_angle"
			resultVar		"$basetexturetransform"
		}

		TextureTransform
		{
			rotateVar		"$hourglass_angle"
			resultVar		"$detailtexturetransform"
		}
	}
}