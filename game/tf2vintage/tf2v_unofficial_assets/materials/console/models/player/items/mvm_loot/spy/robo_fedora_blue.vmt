"VertexLitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/spy/robo_fedora"
	"$bumpmap" "models/player/items/mvm_loot/spy/robo_fedora_normal"

	">=DX90"
	{
	"$envmap" "env_cubemap"
	"$envmaptint" "[.10 .15 .25]"
	}

	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost" "10"
	"$lightwarptexture" "vgui/replay/thumbnails/models/lightwarps/robot_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"
	"$halflambert" "1"

	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "2"

	"$blendtintbybasealpha" "1" 
	"$blendtintcoloroverbase" "1"  

	"$colortint_base" "{28 33 52}"
	"$colortint_tmp" "[0 0 0]" 

	"$color2" "{28 33 52}"

	"$yellow" "0"
	"$one" "1"

	// Cloaking
	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"ItemTintColor"
		{
			"resultVar" "$colortint_tmp"
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}