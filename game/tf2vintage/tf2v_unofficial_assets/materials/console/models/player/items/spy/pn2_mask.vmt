"VertexLitGeneric"
{
	"$basetexture" "models/player/items/spy/pn2_mask"
	"$bumpmap" "models/player/shared/shared_normal"

	"$phong" "1"
	"$phongexponent" "25"
	"$phongboost" "0.1"
	"$phongfresnelranges" "[.25 .5 1]"
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$halflambert" "1"

	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "2"

	"$cloakPassEnabled" "1"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512"
	"$detailscale" "5"
	"$detailblendfactor" "0"
	"$detailblendmode" "6"
	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}