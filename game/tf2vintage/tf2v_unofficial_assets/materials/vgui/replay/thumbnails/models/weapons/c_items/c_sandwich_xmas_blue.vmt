"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\c_items/c_sandwich_xmas_blue"
	"$bumpmap" "models\weapons\c_items/c_sandwich_xmas_normal"

	//phong properties
	"$phong"	"1"
	"$phongboost"	".1"
	"$phongexponent"	"80"
	"$phongfresnelranges"	"[1 2 2.5]"
	"$lightwarptexture" "models/lightwarps/xms_lightwarp"

	"$rimlight"	"1"
	"$rimlightexponent"	"1"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
        	{
         	   	"resultVar" "$glowcolor"
        	}
       	 	"Equals"
        	{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
        	}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
        	}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}