"VertexLitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/models/weapons/c_models/c_hippocrates_bust/c_hippocrates_bust"
	"$bumpmap" "vgui/replay/thumbnails/models/weapons/c_models/c_hippocrates_bust/c_hippocrates_bust_normal"
	"$halflambert" "1"
	
	"$phong"	"1"
	"$phongboost"	".5"
	"$phongexponent"	"20"
	"$phongfresnelranges"	"[.5 1 2]"
	"$lightwarptexture" "models\lightwarps\softened_weapon_lightwarp"
	"$bumpmapalphaphongmask" "1"

	"$envmap" "cubemaps/cubemap_gold001"	
	"$envmaptint" "[.3 .2 .1]"
 	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "20"	
	"$rimlightboost" ".5"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}