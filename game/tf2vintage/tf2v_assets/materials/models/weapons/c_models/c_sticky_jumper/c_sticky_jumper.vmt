"VertexLitGeneric"
{
	"$baseTexture" "models/weapons/c_models/c_sticky_jumper/c_sticky_jumper"

	"$phong" "1"
	"$phongboost" "4"	
	"$phongexponentfactor"  "8"
	"$basemapalphaphongmask" "1"
	"$phongalbedotint" "1"
	"$phongexponenttexture"	"models/weapons/albedo_tint"

	"$phongfresnelranges"	"[1.5 .5 3]"
	"$glowcolor" "1"

	"$detail" 	"models/weapons/c_models/c_stickybomb_launcher/p_stickybomb_launcher_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "1"
	"$detailblendmode" "0"

	"$lightwarptexture" "models\weapons\w_syringe\w_syringe_lightwarp"

	"$tempvar" "0"
	
	"$rimlight" "1"						
	"$rimlightexponent" "7"				
	"$rimlightboost" "0.5"


	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	
	
		"WeaponSkin" {
		}
	}
}