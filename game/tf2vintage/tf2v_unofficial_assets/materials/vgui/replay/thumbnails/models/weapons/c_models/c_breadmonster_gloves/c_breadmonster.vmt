"VertexLitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/models/weapons/c_models/c_breadmonster_gloves/c_breadmonster"
	"$bumpmap" "vgui/replay/thumbnails/models/weapons/c_models/c_breadmonster_gloves/c_breadmonster_normal"

	"$envmap" "cubemaps\cubemap_sheen001"
	"$envmaptint" "[.2 .8 .3]"
	
	"$selfillum" 1
	
	//phong properties
	"$phong"	"1"
	"$phongboost"	".1"
	"$phongexponent" "30"
//	"$lightwarptexture" "models\lightwarps\hand_lightwarp"
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongexponenttexture" "vgui/replay/thumbnails/models/weapons/c_models/c_breadmonster_gloves/c_breadmonster_exp"
	"$phongfresnelranges"	"[1 2 4]"
	"$halflambert" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "2"
	"$rimmask" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"
	"$glowcolor" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"Sine"
		{
			"sineperiod" "2"
			"sinemin" "0.3"
			"sinemax" "1"
			"resultVar"	"$selfillumtint"
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}