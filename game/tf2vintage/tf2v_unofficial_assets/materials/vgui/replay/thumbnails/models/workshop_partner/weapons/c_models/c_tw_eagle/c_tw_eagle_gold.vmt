"VertexlitGeneric"
{
	"$basetexture" "models/workshop_partner/weapons/c_models/c_tw_eagle/c_tw_eagle"

	"$yellow" "0"
	"$glowcolor" "1"

	"$envmap" "effects/saxxy/saxxy_gold"
	"$envmaptint" "[.5 .45 .15]"
	"$basealphaenvmapmask" "1"
	"$basemapalphaphongmask" "1"
	
	"$phongtint" "[1 .75 .3]"
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "5"
	"$phongfresnelranges"	"[.2 1 4]"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"

	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" ".25"
	// Cloaking
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
