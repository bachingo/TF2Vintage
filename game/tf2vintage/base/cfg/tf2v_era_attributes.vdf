"tf2v_era_attributes"
{
    // =========================================================================
    // Per-era weapon attribute overrides for TF2 Vintage.
    //
    // Format:
    //   "item_def_index"
    //   {
    //       "era_integer"
    //       {
    //           "attribute_name"    "value"
    //       }
    //   }
    //
    // "Highest era block <= active era" logic applies — the system finds
    // the nearest era block at or below the active era.
    //
    // These supplement (not replace) the gameplay convar system. Convars
    // handle balance switches (e.g. tf2v_backburner_damage_bonus). This file
    // handles items that changed attribute values across patches.
    // =========================================================================

    // -------------------------------------------------------------------------
    // PYRO — Item 40: The Backburner
    // Era 20: +50HP on hold, no airblast, crits from behind on ignite
    // Era 105: Gains airblast
    // Era 170: Jungle Inferno rework — ammo drain, no HP bonus
    // -------------------------------------------------------------------------
    "40"
    {
        "20"    // Pyro Update Jun 19 2008
        {
            "max_health_additive_bonus"         "50"
            "airblast_disabled"                 "1"
        }
        "105"   // Apr 14 2011 — gains airblast back
        {
            "max_health_additive_bonus"         "50"
            "airblast_disabled"                 "0"
        }
        "170"   // Jungle Inferno Oct 20 2017 — rework
        {
            "max_health_additive_bonus"         "0"
            "airblast_disabled"                 "0"
            "mult_flame_ammopersec"             "0.5"
        }
    }

    // -------------------------------------------------------------------------
    // SOLDIER — Item 13: The Black Box
    // Era 80: +15HP per hit, −1 rocket in clip
    // Era 130: Changed to +15HP per hit (same), rocket count already −1
    // -------------------------------------------------------------------------
    "228"   // Black Box def index
    {
        "80"    // WAR! Dec 17 2009
        {
            "heal_on_hit_for_rapidfire"         "15"
            "clip_size_penalty"                 "-1"
        }
    }

    // -------------------------------------------------------------------------
    // SOLDIER — Item 237: The Battalion's Backup
    // Era 80: Rage fills from taking damage (100 HP taken = full)
    // Era 130: Rage fills from dealing damage
    // -------------------------------------------------------------------------
    "226"
    {
        "80"
        {
            "rage_giving_scale"                 "1"
        }
        "130"
        {
            "rage_giving_scale"                 "1"
        }
    }

    // -------------------------------------------------------------------------
    // DEMOMAN — Item 131: The Chargin' Targe
    // Era 103: +50% fire resist, +20% explosive resist
    // Era 133: Changed resist values
    // -------------------------------------------------------------------------
    "131"
    {
        "103"   // Australian Christmas Dec 17 2010
        {
            "dmg_taken_from_fire_reduced"       "0.5"
            "dmg_taken_from_blast_reduced"      "0.2"
        }
        "133"   // Smissmas 2014 — resist rebalance
        {
            "dmg_taken_from_fire_reduced"       "0.3"
            "dmg_taken_from_blast_reduced"      "0.3"
        }
    }

    // -------------------------------------------------------------------------
    // DEMOMAN — Item 132: The Eyelander
    // Era 103: −25 max health, no random crits, +10% melee range
    // Note: kills grant heads (convar-managed); HP drain handled by convar
    // -------------------------------------------------------------------------
    "132"
    {
        "103"
        {
            "max_health_additive_bonus"         "-25"
            "no_random_critical_hits"           "1"
            "melee_range_multiplier"            "1.1"
        }
    }

    // -------------------------------------------------------------------------
    // HEAVY — Item 15: Natascha
    // Era 30: 20% damage penalty, slows targets on hit
    // Era 32: Fixed (distance-based slowdown)
    // Note: tf2v_natascha_fixed convar handles the fix flag
    // -------------------------------------------------------------------------
    "41"    // Natascha
    {
        "30"
        {
            "damage_penalty"                    "0.2"
            "slow_enemy_on_hit_major"           "1"
        }
    }

    // -------------------------------------------------------------------------
    // ENGINEER — Item 6: The Gunslinger
    // Era 90: Mini-sentry replaces level 1, +25HP
    // Era 130: Combat Mini-Sentry
    // -------------------------------------------------------------------------
    "142"
    {
        "90"
        {
            "max_health_additive_bonus"         "25"
            "engy_mini_building_cost_multiplier" "0.5"
        }
    }

    // -------------------------------------------------------------------------
    // SNIPER — Item 56: Huntsman
    // Era 60: Lit arrows ignite players
    // -------------------------------------------------------------------------
    "56"
    {
        "60"
        {
            "burning_arrow_v2"                  "1"
        }
    }

    // -------------------------------------------------------------------------
    // MEDIC — Item 29: Kritzkrieg
    // Era 1: 25% ÜberCharge rate bonus
    // -------------------------------------------------------------------------
    "35"
    {
        "1"
        {
            "uber_charge_rate"                  "1.25"
        }
    }

    // -------------------------------------------------------------------------
    // SPY — Item 24: Dead Ringer
    // Era 60: Feigns death, 2 second cloak, DR flag carry initially
    // Era 130: Rework — longer cloak, DR flag carry removed (convar-managed)
    // -------------------------------------------------------------------------
    "59"
    {
        "60"
        {
            "cloak_meter_consume_rate"          "1.0"
        }
    }

    // -------------------------------------------------------------------------
    // SCOUT — Item 44: Force-A-Nature
    // Era 50: −34% clip, +10% damage, knockback on shooter, 2-shot
    // Era 61: +10% damage increase added
    // Note: tf2v_fan_damage_bonus convar handles the damage bonus
    // -------------------------------------------------------------------------
    "45"
    {
        "50"
        {
            "clip_size_penalty"                 "-1"
            "damage_bonus"                      "1.0"
            "knockback_push_player"             "1"
        }
        "61"
        {
            "clip_size_penalty"                 "-1"
            "damage_bonus"                      "1.1"
            "knockback_push_player"             "1"
        }
    }

    // -------------------------------------------------------------------------
    // ALL-CLASS — Sandvich (item 42), Buffalo Steak (item 311)
    // Era 30: Sandvich heals 300HP instantly
    // Era 120: Sandvich changes (tf2v_sandvich_behavior convar)
    // -------------------------------------------------------------------------
    "42"
    {
        "30"
        {
            "self_heal_on_taunt"                "1"
        }
    }
}
