//-----------------------------------------------------------------------------
//	LUAJIT.VPC
//
//	LuaJIT 2.1.0-beta3 static library for VScript
//	Builds via amalgamation (ljamalg.c) - requires buildvm pre-build step
//	for lj_vm.asm generation. Build buildvm from host/ before compiling.
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\..\"
$Macro LUAJITSRC	"$SRCDIR\thirdparty\luajit\src"
$Macro OUTLIBDIR	"$LIBCOMMON"

$Include "$SRCDIR\vpc_scripts\source_lib_base.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions		"$BASE;LUAJIT_ENABLE_LUA52COMPAT;LUA_USE_APICHECK" [$DEBUG]
		$PreprocessorDefinitions		"$BASE;LUAJIT_ENABLE_LUA52COMPAT"
		$AdditionalIncludeDirectories	"$BASE;$LUAJITSRC"
		// LuaJIT uses C99 features - needs /TP to compile as C++ or plain C compile
		// Keep as C: don't add /TP. The SDK lib base handles C files fine.
		$WarningLevel					"Level 2 (/W2)"
		$DisableSpecificWarnings		"$BASE;4244;4267;4334;4146;4305"
	}
}

$Configuration "Debug"
{
	$Compiler
	{
		$PreprocessorDefinitions		"$BASE;LUA_USE_ASSERT;LUA_USE_APICHECK"
	}
}

$Project "luajit"
{
	$Folder "Source Files"
	{
		// Amalgamation build - compiles all LuaJIT C source in one TU
		// This avoids needing to list every lj_*.c individually and handles
		// the include order dependencies correctly.
		$File	"$LUAJITSRC\ljamalg.c"
	}

	$Folder "ASM VM" [$WINDOWS]
	{
		// lj_vm.asm is generated by buildvm (host tool).
		// Run: host\buildvm -m peobj -o lj_vm.obj  (after building host\buildvm)
		// The resulting .obj links directly; no separate .asm needed in MSVC.
		// Pre-build custom step handles this if the obj is stale.
		$File	"$LUAJITSRC\lj_vm.asm"		[$WIN64]
		{
			$Configuration
			{
				$CustomBuildStep
				{
					$CommandLine		"ml64.exe /Fo $(OutDir)\lj_vm.obj /c $(InputPath)"
					$Description		"Assembling LuaJIT VM (x64)"
					$Outputs			"$(OutDir)\lj_vm.obj"
				}
			}
		}
	}

	$Folder "Header Files"
	{
		$File	"$LUAJITSRC\lua.h"
		$File	"$LUAJITSRC\luajit.h"
		$File	"$LUAJITSRC\lauxlib.h"
		$File	"$LUAJITSRC\lualib.h"
		$File	"$LUAJITSRC\luaconf.h"
		$File	"$LUAJITSRC\lj_arch.h"
		$File	"$LUAJITSRC\lj_def.h"
		$File	"$LUAJITSRC\lj_obj.h"
		$File	"$LUAJITSRC\lj_vm.h"
	}
}
