"VertexlitGeneric"
{
	"$baseTexture" "models\workshop\weapons\c_models\c_scorch_shot\c_scorch_shot"
	"$basemapalphaphongmask" "1"

	"$phong" "1"
	"$phongexponenttexture" "models\weapons\albedo_tint"
	"$phongexponentfactor" "10"
	"$phongboost" "15"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges" "[1 2 2.5]"
	"$phongalbedotint" "1"

	"$detail" "models\workshop\weapons\c_models\c_scorch_shot\p_scorch_shot_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.5"
	"$detailblendmode" "0"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"{
		}
	}
}