"VertexLitGeneric"
{
	"$basetexture"	"vgui/replay/thumbnails/models/weapons/c_models/c_proto_medigun/fluid"
	"$basemapalphaphongmask" "1"

	"$envmap" "env_cubemap"
	"$envmaptint" "[1 .3 0]"
	"$selfillum" 1
//	"$color2" "[1 .3 .15]"
	
//	"$ambientocclusion" 1

//phong properties
	"$phong"	"1"
	"$phongboost"	"3.5"
	"$phongexponent"	"55"
	"$phongfresnelranges"	"[.5 1 2]"
	"$lightwarptexture" "models/lightwarps/softened_weapon_lightwarp"
	"$halflambert" "1"

	"$rimlight" "1"						
	"$rimlightexponent" "10"				
	"$rimlightboost" "0.45"
	
	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"
	
	"$yellow" "0"
	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 30
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}