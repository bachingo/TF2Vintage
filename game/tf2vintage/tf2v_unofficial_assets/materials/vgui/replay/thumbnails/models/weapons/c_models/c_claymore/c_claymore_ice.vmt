"VertexlitGeneric"
{
	"$baseTexture" "vgui\replay\thumbnails\models\weapons\c_models/c_claymore/c_claymore_ice"
	"$alpha" .5
	"$translucent" 1

	"$halflambert" "1"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.3 .3 .2]"
		
	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "5"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongwarptexture" "vgui\replay\thumbnails\models\lightwarps\xms_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"

	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" "100"


	"$glowcolor" "0"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}