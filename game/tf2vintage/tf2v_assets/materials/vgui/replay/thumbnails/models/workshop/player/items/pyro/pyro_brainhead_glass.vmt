"VertexLitGeneric"
{
	"$basetexture" "models/player/items/pyro/pyro_brainhead"
	"$bumpmap" "models/player/items/pyro/pyro_brainhead_normal"
	"$additive" "1"
	"$yellow" "0"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.3 .3 .3]"
	"$normalmapalphaenvmapmask" "1"

	"$phong" "1"
	"$phongexponent" "35"
	"$phongfresnelranges" "[1 2 4]"
	"$lightwarptexture" "models/lightwarps/jarate_lightwarp"
	"$phongboost" "6"
	"$halflambert" "1"

	"$rimlight" "1"
	"$rimlightexponent" "20"
	"$rimlightboost" "2" 

	"$cloakPassEnabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}
