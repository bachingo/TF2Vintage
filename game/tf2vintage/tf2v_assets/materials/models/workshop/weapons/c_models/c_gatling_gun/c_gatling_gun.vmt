"VertexLitGeneric"
{
	"$basetexture"	"models/workshop/weapons/c_models/c_gatling_gun/c_gatling_gun"
	
	"$phong" "1"
	"$phongboost"	"50"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongexponentfactor" "20"
	"$phongalbedotint" "1"
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongfresnelranges"	"[.2 .5 1]"
	"$halflambert" "1"

	"$detail" "models/workshop/weapons/c_models/c_gatling_gun/p_gatling_gun_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.6"
	"$detailblendmode" "0"

	"$basemapalphaphongmask" "1"

	"$tempvar" "0"
		
	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" ".25"

	"360?$color2" "[ 0.4 0.4 0.4 ]"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"
		{
		}
	}
}