Refract
{
	$normalmap "effects/conc_normal"

	$translucent 1
	$vertexcolor 1
	$vertexalpha 1
	
	$refractamount 1.00
//	$refracttint "[0.5 0.4 0.4]"
	// This always looked ugly no matter how i adjusted it.
	// Having a colored and transparent second sprite (of the same size and shape) behind the Refract sprite looks far better.
	$forcerefract 1
 	$bluramount 2
	$nofog 1
	$vertexcolormodulate 1
}