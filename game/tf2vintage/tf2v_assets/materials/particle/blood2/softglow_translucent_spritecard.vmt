SpriteCard
// SpriteCard unfortunately doesn't look great in dense fog, but it's necessary in order to use $depthblend, which softens the sprite's edges when clipping with nearby geometry.
// I ultimately decided the latter (softer clipping) was more important than the former (better tinting in fog). Especially considering the particles that use this material will be mostly
// transparent, so they shouldn't look TOO jarring in dense fog anyway.
{
	"$basetexture"	"effects/softglow_translucent"
	"$translucent"	1
	"$vertexcolor" 	1
	"$vertexalpha"	1

	"$depthblend" 1
	"$depthblendscale" 50
}