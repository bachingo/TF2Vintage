//-----------------------------------------------------------------------------
//	SERVER_TF2VINTAGE.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME     "tf2vintage" [$SOURCESDK]
$Macro GAMENAME     "tf2vintage" [!$SOURCESDK]

$Include "$SRCDIR\game\server\server_tf.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$SRCDIR\game\shared\tf,.\tf,.\tf\bot"
		$PreprocessorDefinitions		"$BASE;TF_VINTAGE"
	}
}

$Project "Server (TF2V)"
{
		$Folder	"TF2Vintage"
		{
			// Era Information and Enforcement
			$File	"$SRCDIR\game\shared\tf2v\tf2v_attribute_date_loader.cpp"
			$File	"$SRCDIR\game\shared\tf2v\tf2v_attribute_date_loader.h"
		}
}