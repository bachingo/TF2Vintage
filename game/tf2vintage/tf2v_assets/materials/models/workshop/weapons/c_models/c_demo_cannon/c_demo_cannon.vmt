"VertexLitGeneric"
{
	"$baseTexture" "models/workshop/weapons/c_models/c_demo_cannon/c_demo_cannon"

	"$phong" "1"
	"$phongboost" "7.5"	
	"$phongexponentfactor"  "20"
	"$basemapalphaphongmask" "1"
	"$phongalbedotint" "1"
	"$phongexponenttexture"	"models/weapons/albedo_tint"
	"$phongfresnelranges"	"[2 1 3]"
	"$glowcolor" "1"

	"$detail" "models/workshop/weapons/c_models/c_demo_cannon/p_demo_cannon_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.6"
	"$detailblendmode" "0"


	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"	

	"$tempvar" "0"
	
	"$rimlight" "1"						
	"$rimlightexponent" "7"				
	"$rimlightboost" "0.5"


	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"
		{
		}
	}
}