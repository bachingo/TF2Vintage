Refract
{
	<dx90
	{
		 	"$fallbackmaterial" "effects/invuln_overlay_red_dx80"
	}

	%keywords		"tf"
	$forcerefract		1
	$refractamount		0.40	// Note that this is controlled by the Sine proxy below
	$model			1
//	$additive			1

	$normalmap		"effects/invuln_overlay_normal"	// First normalmap provides static alpha mask and subtle overall distortion
	$normalmap2		"water/tfwater001_normal"		// Second normalmap animates and scrolls, and provides more intense, water-like distortion
	$bumpframe		0
	$bluramount		2
	$refracttint		"[0.167 0.333 1.333]"
	$refracttinttexture		"effects/invulnoverlay/invuln_overlay"

	Proxies
	{
		AnimatedTexture
		{
			"animatedtexturevar" "$normalmap2"
			"animatedtextureframenumvar" "$bumpframe2"
			"animatedtextureframerate" 60
		}
		TextureScroll
		{
			"texturescrollvar" "$bumptransform2"
			"texturescrollrate" "0.25"
			"texturescrollangle" "45"
		}
		Sine
		{
			"sinemax"	"0.4"
			"sinemin"		"-0.4"
			"sineperiod"	".81"
			"resultvar" "$refractamount"
		}
	}

}