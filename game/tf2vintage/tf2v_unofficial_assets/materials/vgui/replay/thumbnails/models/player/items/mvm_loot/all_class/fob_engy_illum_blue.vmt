"VertexLitGeneric"
{
	"$basetexture"	"models/player/items/mvm_loot/all_class/fob_illum"	
//	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"	
	"$halflambert" "1"

	"$glowcolor" "1"

	"$colortint_base" "{28 237 228}"
	"$colortint_tmp" "[0 0 0]" 
	"$color2" "{28 237 228}"

	"$selfillum" "1"
//	"$selfillumtint" "[1 1 1]"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$yellow" "0"

	"Proxies"
	{
		"invis"
		{
		}
		"ItemTintColor"
		{
			"resultVar" "$colortint_tmp"
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}