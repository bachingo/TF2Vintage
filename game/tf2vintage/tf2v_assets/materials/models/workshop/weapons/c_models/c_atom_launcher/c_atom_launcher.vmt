"VertexLitGeneric"
{
	"$baseTexture" "models\workshop\weapons\c_models\c_atom_launcher\c_atom_launcher"
	
	"$phong" "1"
	"$phongexponenttexture" "models/weapons/albedo_tint"
	"$phongboost" "500"
	"$phongexponentfactor" "5"
	"$phongalbedotint" "1"
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges"	"[.3 .5 3]"
	"$basemapalphaphongmask" "1"

	"$detail" "models\workshop\weapons\c_models\c_atom_launcher\p_atom_launcher_albedo"
	"$detailscale" "1"
	"$detailblendfactor" "0.7"
	"$detailblendmode" "0"
	
	"$rimlight" "1"					
	"$rimlightexponent" "2"		
	"$rimlightboost" "1"
	"$glowcolor" "1"
	// Cloaking
	"$cloakPassEnabled" "1"

	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
		"WeaponSkin"
		{
		}
	}
}