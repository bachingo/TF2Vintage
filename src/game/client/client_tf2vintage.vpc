//-----------------------------------------------------------------------------
//	CLIENT_TF2VINTAGE.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME     "tf2vintage" [$SOURCESDK]
$Macro GAMENAME     "tf2vintage" [!$SOURCESDK]

$Include "$SRCDIR\game\client\client_tf.vpc"
//$Include "$SRCDIR\coplay\src\coplay.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;tf\vgui"
		$PreprocessorDefinitions			"$BASE;TF_VINTAGE_CLIENT"
	}
}

$Project "Client (TF2V)"
{
		$Folder	"TF2Vintage"
		{
			// Offline inventory emulator
			$File	"$SRCDIR\game\shared\tf\tf2v_offline_inventory.cpp"
			$File	"$SRCDIR\game\shared\tf\tf2v_offline_inventory.h"
			// Era Enforcement
			$File	"$SRCDIR\game\shared\tf\tf_gamerules_era_internal.h"
		}
}